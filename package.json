{
  "name": "dsh-autolearn",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH autonomous-learning plugin: TypeScript engine, native DSH tools, optional MCP adapter.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/adapters/mcp/server.js",
    "./dsh": "./dist/adapters/dsh/plugin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts tests/regression/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "mcp": "node dist/adapters/mcp/server.js",
    "cli": "node dist/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugins/autolearn/cordis.patch.yml"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0"
  },
  "license": "MIT",
  "bin": {
    "dsh-autolearn": "./dist/cli.js"
  }
}
