{
  "name": "@local/dsh-autolearn",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "DSH autonomous-learning plugin: TypeScript engine, 11 native DSH tools, evidence-based verification, strict code-execution sandbox.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
